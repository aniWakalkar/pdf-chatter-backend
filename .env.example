DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
JWT_SECRET=replace_with_a_long_random_secret
INTERNAL_SERVICE_TOKEN=replace_with_another_long_random_secret
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key
AI_CHAT_MODEL=gemini-3.5-flash
AI_FALLBACK_CHAT_MODEL=gemini-3.5-flash-lite
AI_REASONING_EFFORT=low
AI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20
CORS_ORIGINS=http://localhost:5173
AUTH_SERVICE_URL=http://127.0.0.1:8001
DOCUMENT_SERVICE_URL=http://127.0.0.1:8002
CHAT_SERVICE_URL=http://127.0.0.1:8003
